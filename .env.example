COMPOSE_PROJECT_NAME=bridgeworks
APISIX_HTTP_PORT=9080

# Private operational listeners. Docker exposes these only on the bridgeworks network.
METRICS_ADDR=:9090
ORGANIZATION_METRICS_ADDR=:9090

# Identity local development only. Do not reuse for hosted Supabase.
IDENTITY_POSTGRES_DB=bridgeworks_identity
IDENTITY_POSTGRES_USER=bridgeworks_identity
IDENTITY_POSTGRES_PASSWORD=bridgeworks_identity_local
DATABASE_URL=postgres://bridgeworks_identity:bridgeworks_identity_local@identity-postgres:5432/bridgeworks_identity?sslmode=disable
MIGRATION_DATABASE_URL=postgres://bridgeworks_identity:bridgeworks_identity_local@identity-postgres:5432/bridgeworks_identity?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_READINESS_TIMEOUT=2s
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
MIGRATION_TIMEOUT=1m

# Local Identity current-user cache only. Production Upstash must use its external endpoint,
# generated credentials, and TLS. Never commit a real Upstash password.
REDIS_ADDR=identity-redis:6379
REDIS_USERNAME=default
REDIS_PASSWORD=bridgeworks_identity_cache_local
REDIS_TLS_ENABLED=false
REDIS_DIAL_TIMEOUT=500ms
REDIS_OPERATION_TIMEOUT=150ms
CURRENT_USER_CACHE_TTL=30s

# Organization database is separately owned and credentialed.
ORGANIZATION_POSTGRES_DB=bridgeworks_organization
ORGANIZATION_POSTGRES_USER=bridgeworks_organization
ORGANIZATION_POSTGRES_PASSWORD=bridgeworks_organization_local
ORGANIZATION_DATABASE_URL=postgres://bridgeworks_organization:bridgeworks_organization_local@organization-postgres:5432/bridgeworks_organization?sslmode=disable
ORGANIZATION_MIGRATION_DATABASE_URL=postgres://bridgeworks_organization:bridgeworks_organization_local@organization-postgres:5432/bridgeworks_organization?sslmode=disable
ORGANIZATION_DATABASE_CONNECT_TIMEOUT=5s
ORGANIZATION_DATABASE_READINESS_TIMEOUT=2s
ORGANIZATION_DATABASE_MAX_CONNS=5
ORGANIZATION_DATABASE_MIN_CONNS=0
ORGANIZATION_DATABASE_MAX_CONN_LIFETIME=30m
ORGANIZATION_DATABASE_MAX_CONN_IDLE_TIME=5m
ORGANIZATION_DATABASE_HEALTH_CHECK_PERIOD=1m
ORGANIZATION_MIGRATION_TIMEOUT=1m
ORGANIZATION_HTTP_READ_HEADER_TIMEOUT=5s
ORGANIZATION_HTTP_READ_TIMEOUT=15s
ORGANIZATION_HTTP_WRITE_TIMEOUT=15s
ORGANIZATION_HTTP_IDLE_TIMEOUT=60s
ORGANIZATION_HTTP_SHUTDOWN_TIMEOUT=10s

# Dummy local/CI Identity webhook secret.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_Y2xlcmstd2ViaG9vay10ZXN0LXNlY3JldA==
CLERK_WEBHOOK_PROCESS_TIMEOUT=5s
CLERK_WEBHOOK_MAX_BODY_BYTES=1048576

# Dummy local/CI Organization webhook secret.
CLERK_ORGANIZATION_WEBHOOK_SIGNING_SECRET=whsec_b3JnYW5pemF0aW9uLXdlYmhvb2stdGVzdA==
CLERK_ORGANIZATION_WEBHOOK_PROCESS_TIMEOUT=5s
CLERK_ORGANIZATION_WEBHOOK_MAX_BODY_BYTES=1048576

# Dummy local/CI Clerk Backend API key. Never deploy this value.
CLERK_SECRET_KEY=sk_test_bridgeworks_local_membership_administration
CLERK_BACKEND_API_URL=https://api.clerk.com/v1
CLERK_BACKEND_API_TIMEOUT=3s

# Maintained deployment policy input. Organization rejects these domains for business-email proof.
ORGANIZATION_PERSONAL_EMAIL_DOMAINS=gmail.com,outlook.com,yahoo.com,hotmail.com,icloud.com,proton.me,protonmail.com

# Test-only RSA public verification key body. Replace with the matching Clerk instance key.
CLERK_JWT_
CLERK_ISSUER=https://clerk.bridgeworks.test
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:5173
CLERK_AUTH_LEEWAY=5s

IDENTITY_SERVICE_URL=http://identity-service:8080
IDENTITY_SERVICE_AUTH_MODE=none
# Production Cloud Run sets this to the private Identity service HTTPS origin.
IDENTITY_SERVICE_AUDIENCE=
IDENTITY_SERVICE_REQUEST_TIMEOUT=2s
LOG_LEVEL=info
