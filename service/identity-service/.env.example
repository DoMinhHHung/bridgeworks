SERVICE_NAME=identity-service
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

# Runtime role. Use the least-privileged identity-service application role.
DATABASE_URL=postgres://bridgeworks_identity:bridgeworks_identity_local@127.0.0.1:5432/bridgeworks_identity?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_READINESS_TIMEOUT=2s
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m

# Migration/owner role. Local development may use the same role as DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://bridgeworks_identity:bridgeworks_identity_local@127.0.0.1:5432/bridgeworks_identity?sslmode=disable
MIGRATION_TIMEOUT=1m

# Dummy local-only Svix secret. Copy the real Clerk endpoint signing secret in deployed environments.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_Y2xlcmstd2ViaG9vay10ZXN0LXNlY3JldA==
# Must be <=8s, below APISIX's 10s send/read timeout, and less than HTTP_WRITE_TIMEOUT.
CLERK_WEBHOOK_PROCESS_TIMEOUT=5s
CLERK_WEBHOOK_MAX_BODY_BYTES=1048576
