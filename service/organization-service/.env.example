SERVICE_NAME=organization-service
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

DATABASE_URL=postgres://bridgeworks_organization:bridgeworks_organization_local@organization-postgres:5432/bridgeworks_organization?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_READINESS_TIMEOUT=2s
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
MIGRATION_DATABASE_URL=postgres://bridgeworks_organization:bridgeworks_organization_local@organization-postgres:5432/bridgeworks_organization?sslmode=disable
MIGRATION_TIMEOUT=1m

# Local/CI-only RSA public verification key. Replace for any deployed environment.
CLERK_JWT_
CLERK_ISSUER=https://clerk.bridgeworks.test
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:5173
CLERK_AUTH_LEEWAY=5s

# Dummy local/CI Svix secret. Never deploy this value.
CLERK_ORGANIZATION_WEBHOOK_SIGNING_SECRET=whsec_b3JnYW5pemF0aW9uLXdlYmhvb2stdGVzdA==
CLERK_ORGANIZATION_WEBHOOK_PROCESS_TIMEOUT=5s
CLERK_ORGANIZATION_WEBHOOK_MAX_BODY_BYTES=1048576

IDENTITY_SERVICE_URL=http://identity-service:8080
IDENTITY_SERVICE_REQUEST_TIMEOUT=2s
